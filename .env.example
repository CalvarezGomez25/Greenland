# Copia este archivo a .env.local (solo en tu equipo) o configura estas dos
# variables en el entorno de la sesión y en Vercel. NUNCA subas claves reales
# al repositorio y NUNCA uses aquí la clave secreta (service_role / secret).

# URL del proyecto de Supabase: https://CODIGO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (anon / publishable) del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
