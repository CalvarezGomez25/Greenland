# Copia este archivo a .env.local (solo en tu equipo) o configura estas dos
# variables en el entorno de la sesión y en Vercel. NUNCA subas claves reales
# al repositorio y NUNCA uses aquí la clave secreta (service_role / secret).

# URL del proyecto de Supabase: https://CODIGO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (anon / publishable) del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Alertas por correo (opcional; ver README) ----
# Elige UNA forma de enviar: Gmail/SMTP (más simple) o Resend (requiere un dominio verificado).
SMTP_USUARIO=
SMTP_CLAVE=
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PUERTO=465
# RESEND_API_KEY=
# CORREO_REMITENTE=
# Clave inventada por ti (larga y al azar): protege la dirección /api/cron/alertas
CRON_SECRET=
# Usuario de solo lectura con rol "Analista PMO" con el que el resumen diario lee las decisiones pendientes
ALERTAS_USUARIO=
ALERTAS_CLAVE=
# Dirección pública de la plataforma para los enlaces de los correos (si no, se usa la de Vercel)
# URL_PUBLICA=https://tu-plataforma.vercel.app
